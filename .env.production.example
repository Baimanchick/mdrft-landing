APP_IMAGE=ghcr.io/OWNER/m-drift-school@sha256:REPLACE_WITH_IMAGE_DIGEST
DOMAIN=drift.example.com
NEXT_PUBLIC_SITE_URL=https://drift.example.com
LETSENCRYPT_EMAIL=ops@example.com

POSTGRES_DB=mdrift
POSTGRES_ADMIN_USER=mdrift_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
APP_DATABASE_USER=mdrift_app
APP_DATABASE_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_APP_PASSWORD

LEAD_SUBMISSION_ENABLED=true
LEAD_ALLOWED_ORIGIN=https://drift.example.com
LEAD_PROTECTION_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
LEAD_RETENTION_DAYS=REPLACE_WITH_APPROVED_RETENTION_DAYS

TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_LEADS_CHAT_ID=-1000000000000
TELEGRAM_TOPIC_BOOKING_ID=
TELEGRAM_TOPIC_CERTIFICATE_ID=
TELEGRAM_TOPIC_CLUB_ID=
TELEGRAM_TOPIC_PARTNERSHIP_ID=

BACKUP_DIR=/var/backups/mdrift-postgres
BACKUP_RETENTION_DAYS=7
S3_BACKUP_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_BACKUP_REGION=ru-1
S3_BACKUP_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
S3_BACKUP_PREFIX=postgres
AWS_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY
AWS_CA_BUNDLE=/opt/mdrift/.selectels3/root.crt
